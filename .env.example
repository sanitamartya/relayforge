# Application
NODE_ENV=development
PORT=3000

# Database
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=relayforge
DATABASE_URL=postgresql://relayforge:replace_with_a_local_password@localhost:5434/relayforge?schema=public

# Redis
REDIS_URL=redis://localhost:6380
TENANT_RATE_LIMIT_MAX=100
TENANT_RATE_LIMIT_WINDOW_MS=60000
TENANT_RATE_LIMIT_REDIS_TIMEOUT_MS=1500

# Webhook worker (bounded concurrency; 1-100)
WEBHOOK_WORKER_CONCURRENCY=10

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=relayforge

# AI operations assistant (local Ollama; no paid API required)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_OPERATIONS_TIMEOUT_MS=30000
