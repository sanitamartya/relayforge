{
  "name": "relayforge",
  "version": "1.0.0",
  "description": "Production-grade distributed webhook and event delivery platform",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker": "node src/workers/event-worker.js",
    "kafka:worker": "node src/workers/kafka-event-worker.js",
    "tenant:key:rotate": "node scripts/rotate-tenant-api-key.js",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm run test:coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.7.10",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1"
  }
}
